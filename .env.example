# Copy to .env and adjust. Every value is optional.

# Where uploads, meshes and the SQLite database live.
GCG_DATA_DIR=/var/lib/gridfinity-cutout

# Signs the session cookies. Leave empty and one is generated once and stored
# in the data directory; set it explicitly if you run more than one instance.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GCG_SECRET_KEY=

# Set to false once your accounts exist to close the instance off.
# The very first account can always be created, otherwise nobody could start.
GCG_ALLOW_REGISTRATION=true

# Name shown in the interface.
GCG_APP_NAME=Gridfinity Cutout Generator

# Port the container publishes (compose only).
GCG_PORT=8000

# Upload limits.
GCG_MAX_UPLOAD_MB=40
GCG_MAX_SCAN_IMAGES=200

# How long a session stays valid.
GCG_TOKEN_TTL_HOURS=336

# Default reconstruction resolution in millimetres. Smaller is finer and much
# slower; 0.5 is a good balance on a modern desktop CPU.
GCG_SCAN_VOXEL_MM=0.5

# Cores the worker container may use (compose only).
# Only needed when the frontend is served from a different origin during
# development, e.g. http://localhost:5173
GCG_CORS_ORIGINS=
